{
  "name": "jp-trainer",
  "version": "0.1.0",
  "description": "AI-native Japanese N2 training that piggybacks on Claude Code / Codex / Gemini workflows",
  "type": "module",
  "module": "src/cli.ts",
  "bin": {
    "jp": "src/cli.ts"
  },
  "scripts": {
    "build": "bun build src/cli.ts --compile --outfile dist/jp",
    "install-bin": "bun build src/cli.ts --compile --outfile ~/.local/bin/jp",
    "test": "bun test",
    "dev": "bun run src/cli.ts"
  },
  "dependencies": {
    "ts-fsrs": "^4.6.1",
    "yaml": "^2.6.1",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
